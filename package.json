{
  "name": "the-pattern-beneath",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:model": "node scripts/audit-model.mjs",
    "format:check": "prettier --check src tests scripts/audit-model.mjs *.ts *.json",
    "test:game": "node scripts/web-game-client.mjs --url http://127.0.0.1:5173 --actions-file tests/game-actions.json --click-selector #start-btn --iterations 1 --pause-ms 250 --screenshot-dir output/web-game"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
